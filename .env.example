# Copy to .env (never commit .env) or export these in your shell.
# The bot runs fully without a key (deterministic fallback); a key enables
# live Gemini copywriting at temperature=0.

# Live Gemini copywriter (Google AI Studio key)
GEMINI_API_KEY=

# Copywriter model chain head (fallback: gemini-2.5-flash)
GEMINI_MODEL=gemini-3.8-flash

# Judge harness scoring model
JUDGE_LLM_MODEL=gemini-3.8-flash

# Local server port (platforms inject $PORT on deploy)
PORT=8080
